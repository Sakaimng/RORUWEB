{
  "// note": "The Next.js app lives in ./site. These settings point editor tooling there so opening RORUWEB/ at the root behaves like opening site/ directly.",

  "css.lint.unknownAtRules": "ignore",

  "typescript.tsdk": "site/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  "eslint.workingDirectories": [
    { "directory": "site", "changeProcessCWD": true }
  ],

  "tailwindCSS.experimental.configFile": "site/tailwind.config.ts",
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },

  "npm.packageManager": "npm",
  "terminal.integrated.cwd": "${workspaceFolder}/site",

  "files.exclude": {
    "site/.next": true,
    "site/node_modules": true,
    "site/.vercel": true,
    "**/*.tsbuildinfo": true
  },
  "files.watcherExclude": {
    "site/.next/**": true,
    "site/node_modules/**": true,
    "site/public/20260314 Invite only opening/**": true,
    "site/public/20260321 Six pack chef/**": true,
    "site/public/20260425 DELIA x RORUBARU/**": true,
    "site/public/Menus SVG/**": true
  },
  "search.exclude": {
    "site/.next": true,
    "site/node_modules": true,
    "site/package-lock.json": true,
    "**/*.tsbuildinfo": true,
    "site/public/20260314 Invite only opening": true,
    "site/public/20260321 Six pack chef": true,
    "site/public/20260425 DELIA x RORUBARU": true,
    "site/public/Menus SVG": true
  },
  "git.ignoreLimitWarning": true
}
